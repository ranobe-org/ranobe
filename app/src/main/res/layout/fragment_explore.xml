<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="200dp"
    tools:context=".ui.explore.Explore">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:text="@string/nav_explore"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?colorOnSurface" />

        <!-- Continue reading -->
        <TextView
            android:id="@+id/continue_reading_info"
            style="@style/SectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/continue_reading_info"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/continue_reading"
            style="@style/SectionCard"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <!-- ConstraintLayout so the card grows to fit the text and button instead of clipping to the cover -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/novel_cover_layout"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="88dp"
                    android:layout_height="128dp"
                    android:clickable="true"
                    android:contentDescription="@string/history_open_details"
                    android:focusable="true"
                    app:cardCornerRadius="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/novel_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/image"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/novelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?colorOnSurface"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/novel_cover_layout"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/lastReadChapter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?colorOnSurfaceVariant"
                    app:layout_constraintEnd_toEndOf="@id/novelTitle"
                    app:layout_constraintStart_toStartOf="@id/novelTitle"
                    app:layout_constraintTop_toBottomOf="@id/novelTitle" />

                <TextView
                    android:id="@+id/lastReadTimestamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?colorOutline"
                    app:drawableStartCompat="@drawable/ic_history_small"
                    app:drawableTint="?colorOutline"
                    app:layout_constraintEnd_toEndOf="@id/novelTitle"
                    app:layout_constraintStart_toStartOf="@id/novelTitle"
                    app:layout_constraintTop_toBottomOf="@id/lastReadChapter" />

                <!-- sits below the text, and at the cover's bottom edge when the text is short -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continueBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/continue_btn"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/novelTitle"
                    app:layout_constraintStart_toStartOf="@id/novelTitle"
                    app:layout_constraintTop_toBottomOf="@id/lastReadTimestamp"
                    app:layout_constraintVertical_bias="1" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Sources -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/source_info"
                style="@style/SectionTitle"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="@string/browse_sources" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manage_sources"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage" />

        </LinearLayout>

        <TextView
            android:id="@+id/sources_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="10dp"
            android:text="@string/sources_browse_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/source_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingVertical="4dp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
