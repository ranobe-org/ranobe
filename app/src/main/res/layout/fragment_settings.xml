<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="200dp"
    tools:context=".ui.settings.Settings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/nav_settings"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?colorOnSurface" />

        <!-- App header -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?colorPrimaryContainer"
            app:cardCornerRadius="28dp"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardBackgroundColor="?colorSurface"
                        app:cardCornerRadius="20dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/app_name"
                            android:src="@mipmap/ic_launcher_round" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_name"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="?colorOnPrimaryContainer"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/edition_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_setting_icon"
                                android:backgroundTint="?colorPrimary"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?colorOnPrimary"
                                android:textStyle="bold"
                                tools:text="@string/edition_free" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/app_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?colorOnPrimaryContainer"
                            tools:text="v0.0.15" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_tagline"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?colorOnPrimaryContainer" />

                <!-- shown only when a newer release exists -->
                <LinearLayout
                    android:id="@+id/update_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_setting_icon"
                    android:backgroundTint="?colorSurface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/version_string"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/get_update"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/update" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pro_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/get_pro"
                    android:visibility="gone"
                    app:icon="@drawable/ic_open_in_new"
                    app:iconGravity="textEnd"
                    app:iconSize="18dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Appearance -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/settings_appearance" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <org.ranobe.ranobe.ui.views.SettingOptionView
                    android:id="@+id/theme_mode_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_theme_mode_auto"
                    app:settingSubtitle="@string/settings_theme_sub"
                    app:settingTitle="@string/settings_theme" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/theme_mode_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/theme_auto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/automatic"
                        app:icon="@drawable/ic_theme_mode_auto"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/theme_light"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/light"
                        app:icon="@drawable/ic_theme_mode_light"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/theme_dark"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dark"
                        app:icon="@drawable/ic_theme_mode_night"
                        app:iconSize="18dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Reading -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/settings_reading" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <org.ranobe.ranobe.ui.views.SettingOptionView
                    android:id="@+id/chapter_updates_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_notifications_active"
                    app:settingSubtitle="@string/new_chapter_updates_sub"
                    app:settingTitle="@string/new_chapter_updates" />

                <com.google.android.material.divider.MaterialDivider
                    style="@style/SettingsDivider" />

                <org.ranobe.ranobe.ui.views.SettingOptionView
                    android:id="@+id/volume_scroll_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_volume"
                    app:settingSubtitle="@string/volume_key_scroll_sub_text"
                    app:settingTitle="@string/volume_key_scroll" />

                <include
                    android:id="@+id/scroll_speed_setting"
                    layout="@layout/view_scroll_speed_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- About -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/settings_about" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <org.ranobe.ranobe.ui.views.SettingOptionView
                    android:id="@+id/project_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingExternal="true"
                    app:settingIcon="@drawable/ic_github"
                    app:settingSubtitle="github.com/ranobe-org/ranobe"
                    app:settingTitle="GitHub" />

                <com.google.android.material.divider.MaterialDivider
                    style="@style/SettingsDivider" />

                <org.ranobe.ranobe.ui.views.SettingOptionView
                    android:id="@+id/discord_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingExternal="true"
                    app:settingIcon="@drawable/ic_discord"
                    app:settingSubtitle="discord.gg/6CQ6u64dca"
                    app:settingTitle="Discord" />

                <com.google.android.material.divider.MaterialDivider
                    style="@style/SettingsDivider" />

                <org.ranobe.ranobe.ui.views.SettingOptionView
                    android:id="@+id/music_player_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingExternal="true"
                    app:settingIcon="@drawable/ic_android"
                    app:settingSubtitle="@string/mp_lite_subtitle"
                    app:settingTitle="Music Player Lite" />

                <com.google.android.material.divider.MaterialDivider
                    style="@style/SettingsDivider" />

                <org.ranobe.ranobe.ui.views.SettingOptionView
                    android:id="@+id/ranobem_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingExternal="true"
                    app:settingIcon="@drawable/ic_android"
                    app:settingSubtitle="@string/ranobem_subtitle"
                    app:settingTitle="RanobeM" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/settings_footer"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?colorOutline" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
